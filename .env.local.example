# ============================================================
# Hoshiyomi 環境変数テンプレート
# このファイルをコピーして .env.local を作成してください
# .env.local は Git にコミットしないこと！
# ============================================================

# Anthropic Claude API
# https://console.anthropic.com でAPIキーを取得
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxx

# NextAuth.js 認証
# openssl rand -base64 32 で生成
NEXTAUTH_SECRET=your-secret-key-here
NEXTAUTH_URL=http://localhost:3000

# Stripe 決済
# https://dashboard.stripe.com でキーを取得
STRIPE_SECRET_KEY=your_stripe_secret_key_here
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=your_stripe_publishable_key_here

# Stripe Price IDs（Stripeダッシュボードで作成）
STRIPE_PRICE_STANDARD_MONTHLY=price_xxxxxxxxxxxxxxxx
STRIPE_PRICE_PREMIUM_YEARLY=price_xxxxxxxxxxxxxxxx

# Stripe Webhook
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxxxxxx

# データベース（Supabase）
# https://supabase.com でプロジェクト作成後に取得
DATABASE_URL=postgresql://postgres:[password]@db.[project].supabase.co:5432/postgres
NEXT_PUBLIC_SUPABASE_URL=https://[project].supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyxxxxxxxxxxxxxxxxxxxxxxxx

# アプリURL（本番環境）
NEXT_PUBLIC_APP_URL=https://hoshiyomi.jp
